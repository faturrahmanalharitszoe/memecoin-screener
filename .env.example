# Optional: untuk social velocity REAL (bukan proxy) - BUTUH PAID PLAN untuk social endpoints
# Daftar di https://lunarcrush.com/developers (free Hobby cuma market-data, social butuh paid)
LUNARCRUSH_API_KEY=your_key_here

# Optional: untuk holder detail fallback via Birdeye (gratis 100 req/hari)
# Daftar di https://docs.birdeye.so/ - dapat API key gratis
BIRDEYE_API_KEY=your_birdeye_key_here

# Dashboard port (default 5001)
# PORT=5001
