# ============================================
# MEME SCREENER DASHBOARD - Environment Variables
# ============================================

# --- SOCIAL VELOCITY (Optional) ---
# LunarCrush: social metrics real (bukan proxy)
# Daftar: https://lunarcrush.com/developers (free Hobby cuma market-data)
# LUNARCRUSH_API_KEY=your_lunarcrush_key

# Birdeye: holder detail fallback (gratis 100 req/hari)
# Daftar: https://docs.birdeye.so/
# BIRDEYE_API_KEY=your_birdeye_key

# --- DASHBOARD ---
# PORT=5001

# --- SUPABASE (Paper + Real Portfolio Database) ---
# Buat project gratis: https://supabase.com
# 1. Create project baru
# 2. SQL Editor -> paste schema dari README
# 3. Settings -> API -> copy URL + anon key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# --- SOLANA (Real Trade via Jupiter) ---
# RPC endpoint: Helius/QuickNode free tier (50k req/day)
# Daftar: https://helius.dev atau https://quicknode.com
SOLANA_RPC=https://mainnet.helius-rpc.com/?api-key=your_helius_key

# Private key wallet (Phantom export -> Settings -> Export Private Key)
# HATI-HATI: JANGAN commit ke git! Set di Render Dashboard -> Environment
# Format: base58 encoded (64 bytes)
PRIVATE_KEY=your_base58_private_key

# --- TRADING SETTINGS ---
# Max trade size per buy (persen dari balance, default 2%)
TRADE_SIZE_PCT=2

# Slippage tolerance (basis points, 500 = 5%)
SLIPPAGE_BPS=500

# Priority fee in lamports (0.001 SOL = 1000000)
PRIORITY_FEE_LAMPORTS=1000000

# Auto-trade: set "true" untuk auto-buy saat bagger signal detected
# AUTO_TRADE=false
